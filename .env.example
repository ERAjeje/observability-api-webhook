# ─── Server ───────────────────────────────────────────────────────────────
HTTP_ADDR=:8080
ENV=development

# ─── Database ─────────────────────────────────────────────────────────────
# Local (sem Docker) deixe vazio para usar o store em memória (dev):
# DB_DSN=
# Produção (Docker Compose):
DB_DSN=postgres://monitor:monitor@postgres:5432/monitor?sslmode=disable
DB_PASSWORD=monitor            # usado pelo docker-compose para criar o postgres
AUTO_MIGRATE=true              # aplica migrations ao subir o container

# ─── Worker Pool (Core Engine) ─────────────────────────────────────────────
WORKER_POOL_SIZE=20
POOL_QUEUE_SIZE=1000
MAX_BATCH_SIZE=100
BATCH_FLUSH_SECONDS=1

# ─── Scheduler ────────────────────────────────────────────────────────────
SCHEDULER_TICK_SECONDS=10
JITTER_FRACTION=0.2

# ─── Segurança — egress do checker (SSRF guard) ───────────────────────────
# false (default): bloqueia loopback, RFC1918, link-local e metadata cloud.
# true: permite monitorar serviços internos — USE SÓ EM AMBIENTE CONTROLADO.
ALLOW_PRIVATE_TARGETS=false

# ─── State Machine (janela de confirmação) ────────────────────────────────
FAIL_THRESHOLD=3               # N falhas consecutivas → DOWN
SUCCESS_THRESHOLD=2            # M sucessos consecutivos → UP

# ─── SSE (Fase 3) ─────────────────────────────────────────────────────────
SSE_HEARTBEAT_SECONDS=15

# ─── Auth (Fase 3) ────────────────────────────────────────────────────────
JWT_SECRET=change-me            # troque por chave forte (>= 32 bytes) em produção
JWT_TTL_HOURS=24                # expiração do token
AUTH_RATE_LIMIT=5               # tentativas de login/signup por janela (RNF-017)
AUTH_RATE_WINDOW_SECONDS=60

# ─── Segurança — headers em repouso (S-05) ────────────────────────────────
# Chave AES-256 (64 hex chars) para cifrar os headers de autenticação dos
# endpoints no jsonb endpoints.headers. Vazia = texto plano (só para dev);
# gere com: openssl rand -hex 32. Se o banco já tiver blobs cifrados, NÃO
# remova esta chave (o engine segue sem headers — fail-closed).
HEADERS_ENC_KEY=

# ─── Notifier (T3.7) — e-mail (SMTP) ──────────────────────────────────────
NOTIFY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=monitor@example.com
NOTIFY_TO_EMAIL=

# ─── Notifier — webhook (Slack/Discord) ───────────────────────────────────
NOTIFY_WEBHOOK_URL=

# ─── Notifier — comportamento (RNF-006/RNF-007) ───────────────────────────
NOTIFY_SUPPRESSION_SECONDS=300   # janela anti-enxurrada por endpoint
NOTIFY_RETRIES=3                 # tentativas por canal com backoff
NOTIFY_TIMEOUT_SECONDS=5         # timeout da tentativa (short — RNF-006)